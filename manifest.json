{
  "manifest_version": 3,
  "name": "PDF Citation Hover",
  "version": "2.1.0",
  "description": "PDF viewer that shows the paper title when you hover over a citation.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "PDF Citation Hover: ON (click to turn off)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}